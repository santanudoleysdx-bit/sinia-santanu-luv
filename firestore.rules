rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isCoupleMember() {
      return request.auth != null
        && request.auth.token.email in [
          'REPLACE_WITH_SANTANU_EMAIL',
          'REPLACE_WITH_SINIA_EMAIL'
        ];
    }
    match /coupleChats/sinia-santanu/messages/{messageId} {
      allow read: if isCoupleMember();
      allow create: if isCoupleMember()
        && request.resource.data.keys().hasOnly(['text', 'uid', 'senderName', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
